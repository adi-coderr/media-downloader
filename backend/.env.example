# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Media inspection engine
# Path to the yt-dlp binary used to inspect publicly accessible, non-DRM media.
# yt-dlp only ever surfaces streams that the source site already exposes publicly;
# it does not decrypt, bypass DRM, or circumvent authentication.
YTDLP_PATH=yt-dlp

# Inspection / download timeouts (ms)
INSPECT_TIMEOUT_MS=25000
DOWNLOAD_MAX_CONCURRENCY=3

# Where completed/partial downloads are staged on the server before streaming to the client
DOWNLOAD_STAGING_DIR=./downloads
